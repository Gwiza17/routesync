# ── Server ──────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ─────────────────────────────────────────
# Leave blank to use SQLite (local dev, no setup needed)
# Set to a PostgreSQL URL for production (Railway, Supabase, Neon, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/routesync

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string

# ── Google Maps ──────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# ── Stripe ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# ── CORS ─────────────────────────────────────────────
CLIENT_URL=http://localhost:19006
