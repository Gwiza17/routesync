{
  "expo": {
    "name": "RouteSync",
    "slug": "routesync",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyAK-_1UOvBRrgzF_8ixof5YE269I08C_XE"
      }
    },
    "android": {
      "package": "com.routesync.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAK-_1UOvBRrgzF_8ixof5YE269I08C_XE"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.routesync",
          "enableGooglePay": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RouteSync to access your camera to scan driver QR codes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "abeab518-3d3e-493d-81b4-574d1fc870b9"
      }
    },
    "owner": "tshanda"
  }
}
