# ── API ──────────────────────────────────────────────
# Local dev (same Wi-Fi): use your Mac's IP address
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000/api
#
# Local dev (tunnel): still use Mac IP — tunnel is only for the Expo bundle
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000/api
#
# Production / Railway deployment:
EXPO_PUBLIC_API_URL=https://your-app.up.railway.app/api

# ── Stripe ───────────────────────────────────────────
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ── Expo ─────────────────────────────────────────────
EXPO_PUBLIC_PROJECT_ID=your_expo_project_id
